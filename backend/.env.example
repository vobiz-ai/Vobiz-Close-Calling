# Deployment settings only. No Vobiz Auth ID, Auth Token, number, endpoint id
# or application id, and no Close API key, belongs in this file: agents sign
# in from the softphone. Copy to backend/.env (gitignored) and fill in.

PORT=8098

# The public https URL Vobiz and the agents' browsers reach this server on.
# Behind a tunnel, this is the tunnel's URL. Signature checks and the Close
# OAuth redirect (<PUBLIC_BASE_URL>/close/oauth/callback) are built from it.
PUBLIC_BASE_URL=https://calling.example.com

# The Close OAuth app (Close: Settings > Developer > OAuth Apps). Give it the
# offline_access scope and the redirect URL above. Leave both empty to have
# each agent connect with their own Close API key instead.
CLOSE_CLIENT_ID=
CLOSE_CLIENT_SECRET=

# With an OAuth app set up, "false" hides the API-key option.
CLOSE_ALLOW_API_KEYS=true

# 32+ random bytes. Signs recording links. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SIGNING_SECRET=

# 32 random bytes as 64 hex characters. Encrypts stored Close refresh tokens
# and API keys. Generate the same way as SIGNING_SECRET.
TOKEN_ENC_KEY=

# Where endpoint ids, organizations and encrypted credentials are kept (mode 0600).
DATA_DIR=./data

# Country for numbers typed without a country code (IN, US, GB, AE, SG, AU, ...).
# Each Close organization can override it in Settings.
DEFAULT_COUNTRY=IN

# Default lifetime of recording links, in seconds. Settings can change it.
# Close plays the recording from this link, so it stops playing there once
# the link expires.
RECORDING_LINK_TTL_SECONDS=900

# How the softphone registers with Vobiz. "jwt" (default): a short-lived
# access token per agent, signed by Vobiz with the account's Auth Token, so
# the browser never holds a long-lived secret. "endpoint": one SIP endpoint
# per agent, with a password rotated at each sign-in.
VOBIZ_SIP_AUTH=jwt

# Access-token lifetime in seconds (180 to 86400). The softphone fetches a new
# token a minute before this runs out and registers again.
VOBIZ_JWT_TTL_SECONDS=3600

# Vobiz callback signatures: require (default) | verify | off. Leave it on
# "require" in production. "verify" accepts an unsigned request but rejects a
# wrong one.
VOBIZ_WEBHOOK_SIGNATURES=require

# Hosts that may receive the Vobiz Auth ID and Token when recording audio is
# fetched, comma separated; "*." matches subdomains. Other hosts (presigned
# storage URLs) are fetched without credentials.
VOBIZ_MEDIA_HOSTS=*.vobiz.ai
